# Enforce consistent cross-platform line endings (Windows <-> macOS cohabitation)
* text=auto eol=lf

# macOS / Unix scripts and documentation MUST stay LF even on Windows
*.command text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.m text eol=lf
*.h text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows-native scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.zip binary
*.exe binary
*.dll binary
*.dylib binary
*.png binary
*.ico binary
